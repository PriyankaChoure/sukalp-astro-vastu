# Copy to .env.local and fill in. Never commit real values.
# Development: everything below is optional. Production: all are required.
# Check with: npm run check:env:strict

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (pooled URL for the app, direct URL for migrations)
DATABASE_URL=
DIRECT_URL=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Resend
RESEND_API_KEY=
EMAIL_FROM=

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Cloudflare R2 (private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Admin + signed tokens
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Rate limiting and spam protection
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sanity (blog)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# CI only: skip strict validation when building without secrets
# SKIP_ENV_VALIDATION=1